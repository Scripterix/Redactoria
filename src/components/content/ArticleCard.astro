---
import type { CollectionEntry } from 'astro:content';

interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const publishedDate = article.data.created.toLocaleDateString('pl-PL', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<article class="card">
	<p class="card__meta">
		<span>{article.data.topic.id.replaceAll('-', ' ')}</span>
		<span aria-hidden="true">·</span>
		<time datetime={article.data.created.toISOString()}>{publishedDate}</time>
	</p>
	<h2><a href={`/artykuly/${article.data.slug}/`}>{article.data.title}</a></h2>
	<p class="card__description">{article.data.description}</p>
	<a class="card__link" href={`/artykuly/${article.data.slug}/`} aria-label={`Czytaj: ${article.data.title}`}>
		Czytaj artykuł <span aria-hidden="true">→</span>
	</a>
</article>

<style>
	.card {
		display: flex;
		min-height: 19rem;
		padding: clamp(1.4rem, 3vw, 2rem);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-medium);
		background: rgba(252, 250, 244, 0.7);
		flex-direction: column;
	}

	.card__meta {
		display: flex;
		margin: 0 0 2.25rem;
		gap: 0.5rem;
		color: var(--color-subtle);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.65rem, 3vw, 2.25rem);
		font-weight: 400;
		line-height: 1.1;
	}

	h2 a {
		text-decoration: none;
	}

	h2 a:hover {
		color: var(--color-accent);
	}

	.card__description {
		margin: 1.15rem 0 2rem;
		color: var(--color-muted);
		line-height: 1.65;
	}

	.card__link {
		margin-top: auto;
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.card__link span {
		color: var(--color-accent);
		font-size: 1rem;
	}
</style>
