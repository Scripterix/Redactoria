{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvedForPublication": {
      "const": false,
      "type": "boolean"
    },
    "articleHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "criticReviewHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "criticReviewRef": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "criticVerdict": {
      "const": "PASS",
      "type": "string"
    },
    "draftMetadataHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "draftMetadataRef": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "draftRef": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "humanPublicationDecision": {
      "const": "pending",
      "type": "string"
    },
    "preparedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "published": {
      "const": false,
      "type": "boolean"
    },
    "readyForHumanPublicationDecision": {
      "const": true,
      "type": "boolean"
    },
    "researchApproval": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "researchPacket": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "reviewedDraft": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "DRAFT",
          "type": "string"
        },
        "approvedArtifacts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "articleHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "audience": {
          "minLength": 1,
          "type": "string"
        },
        "interactionOpportunities": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "expectedConcept": {
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "implemented": {
                "const": false,
                "type": "boolean"
              },
              "prompt": {
                "minLength": 1,
                "type": "string"
              },
              "purpose": {
                "minLength": 1,
                "type": "string"
              },
              "sectionId": {
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "mini-quiz",
                  "show-output",
                  "hint",
                  "exercise",
                  "next-step"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "sectionId",
              "type",
              "purpose",
              "prompt",
              "expectedConcept",
              "implemented"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 2,
          "type": "array"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "researchApproval": {
          "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
          "type": "string"
        },
        "researchPacket": {
          "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
          "type": "string"
        },
        "runtimeVerification": {
          "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "sections": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "body": {
                "minLength": 1,
                "type": "string"
              },
              "coverage": {
                "items": {
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "type": "string"
                },
                "type": "array"
              },
              "evidence": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "finding",
                        "addendum"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "examples": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "expectedDiagnostics": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "expectedOutput": {
                      "type": "string"
                    },
                    "id": {
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "type": "string"
                    },
                    "purpose": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "purpose",
                    "code",
                    "expectedOutput",
                    "expectedDiagnostics"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "heading": {
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "heading",
              "body",
              "coverage",
              "evidence",
              "examples"
            ],
            "type": "object"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "sourceDecision": {
          "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
          "type": "string"
        },
        "sources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "contentHash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "providedCharacters": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "sourceId": {
                "minLength": 1,
                "type": "string"
              },
              "sourcePath": {
                "minLength": 1,
                "type": "string"
              },
              "title": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "truncated": {
                "const": false,
                "type": "boolean"
              }
            },
            "required": [
              "sourceId",
              "sourcePath",
              "contentHash",
              "title",
              "providedCharacters",
              "truncated"
            ],
            "type": "object"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        "status": {
          "const": "draft",
          "type": "string"
        },
        "targetPhpVersions": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "8.4",
              "type": "string"
            },
            {
              "const": "8.5",
              "type": "string"
            }
          ],
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "topic": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "wordCount": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "writerExecution": {
          "additionalProperties": false,
          "properties": {
            "inputHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "model": {
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "minLength": 1,
                  "type": "string"
                },
                "mode": {
                  "enum": [
                    "imported-session-analysis",
                    "live",
                    "test"
                  ],
                  "type": "string"
                },
                "model": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "adapter",
                "model",
                "mode"
              ],
              "type": "object"
            },
            "modelCalls": {
              "const": 1,
              "type": "number"
            },
            "requestHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "inputHash",
            "requestHash",
            "model",
            "modelCalls"
          ],
          "type": "object"
        }
      },
      "required": [
        "action",
        "title",
        "targetPhpVersions",
        "sections",
        "limitations",
        "schemaVersion",
        "status",
        "topic",
        "audience",
        "sourceDecision",
        "researchPacket",
        "researchApproval",
        "runtimeVerification",
        "sources",
        "approvedArtifacts",
        "wordCount",
        "articleHash",
        "writerExecution"
      ],
      "type": "object"
    },
    "revisionHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "revisionRef": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "runtimeVerification": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "sourceDecision": {
      "pattern": "^lab\\/(decisions|cartography|research|drafts|reviews|inventory)\\/[a-zA-Z0-9/_-]+\\.(json|md)$",
      "type": "string"
    },
    "status": {
      "const": "publication-candidate",
      "type": "string"
    },
    "targetPhpVersions": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": "8.4",
          "type": "string"
        },
        {
          "const": "8.5",
          "type": "string"
        }
      ],
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "topic": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "wordCount": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "topic",
    "title",
    "criticVerdict",
    "targetPhpVersions",
    "sourceDecision",
    "researchPacket",
    "researchApproval",
    "runtimeVerification",
    "draftRef",
    "draftMetadataRef",
    "criticReviewRef",
    "revisionRef",
    "articleHash",
    "draftMetadataHash",
    "criticReviewHash",
    "revisionHash",
    "wordCount",
    "preparedAt",
    "readyForHumanPublicationDecision",
    "humanPublicationDecision",
    "approvedForPublication",
    "published",
    "reviewedDraft"
  ],
  "type": "object"
}
