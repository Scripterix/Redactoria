---
import type { CollectionEntry } from 'astro:content';
import ArticleMeta from '../components/content/ArticleMeta.astro';
import SourceList from '../components/content/SourceList.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
---

<BaseLayout title={article.data.title} description={article.data.description} type="article">
	<article class="article container">
		<header class="article__header">
			<p class="article__eyebrow">{article.data.domain.replaceAll('-', ' ')}</p>
			<h1>{article.data.title}</h1>
			<p class="article__description">{article.data.description}</p>
			<ArticleMeta {article} />
		</header>

		<div class="article__body">
			<slot />
			<SourceList sources={article.data.sources} />
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		padding-block: clamp(4rem, 9vw, 8rem);
	}

	.article__header {
		max-width: 58rem;
		margin-inline: auto;
		padding-bottom: clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--color-line);
	}

	.article__eyebrow {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 7vw, 6rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.95;
	}

	.article__description {
		max-width: 43rem;
		margin: 1.75rem 0 0;
		color: var(--color-muted);
		font-family: var(--font-serif);
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.article__body {
		max-width: var(--text-width);
		margin: clamp(3rem, 6vw, 5rem) auto 0;
		font-family: var(--font-serif);
		font-size: clamp(1.05rem, 1.5vw, 1.16rem);
		line-height: 1.8;
	}

	.article__body :global(h2) {
		margin: 2.5em 0 0.7em;
		font-size: clamp(1.75rem, 4vw, 2.35rem);
		font-weight: 400;
		line-height: 1.15;
	}

	.article__body :global(p) {
		color: #46423a;
	}

	.article__body :global(a) {
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.18em;
	}
</style>
