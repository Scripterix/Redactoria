---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterArticlesByTopic, getPublishedArticles, getPublishedTopics } from '../../lib/content';

const [topics, articles] = await Promise.all([getPublishedTopics(), getPublishedArticles()]);
---

<BaseLayout title="Tematy" description="Obszary wiedzy rozwijane w Redactoria EDU.">
	<section class="topics container">
		<header>
			<p>Mapa wiedzy</p>
			<h1>Tematy</h1>
		</header>

		<div class="topics__list">
			{topics.map((topic) => {
				const count = filterArticlesByTopic(articles, topic.id).length;
				return (
					<a class="topic" href={`/tematy/${topic.data.slug}/`}>
						<span class="topic__count">{String(count).padStart(2, '0')}</span>
						<span>
							<strong>{topic.data.name}</strong>
							<small>{topic.data.description}</small>
						</span>
						<span class="topic__arrow" aria-hidden="true">→</span>
					</a>
				);
			})}
		</div>
	</section>
</BaseLayout>

<style>
	.topics {
		padding-block: clamp(4rem, 9vw, 8rem);
	}

	header {
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}

	header p {
		margin: 0 0 0.5rem;
		color: var(--color-accent);
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(3.5rem, 9vw, 7.5rem);
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 0.9;
	}

	.topics__list {
		border-top: 1px solid var(--color-line);
	}

	.topic {
		display: grid;
		padding-block: clamp(1.5rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--color-line);
		grid-template-columns: 3rem 1fr auto;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
	}

	.topic:hover strong,
	.topic:hover .topic__arrow {
		color: var(--color-accent);
	}

	.topic__count {
		color: var(--color-subtle);
		font-size: 0.7rem;
		font-weight: 700;
	}

	.topic strong,
	.topic small {
		display: block;
	}

	.topic strong {
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 4vw, 2.5rem);
		font-weight: 400;
	}

	.topic small {
		margin-top: 0.35rem;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.topic__arrow {
		font-size: 1.5rem;
	}
</style>
